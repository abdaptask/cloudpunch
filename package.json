{
  "name": "cloudpunch",
  "version": "0.0.0",
  "private": true,
  "description": "Employee time and attendance platform for apTask remote workers.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.1"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudpunch.aptask.com/schemas/user-prompt-response.schema.json",
  "title": "USER_PROMPT_RESPONSE event",
  "description": "The user's answer to the 5-minute idle prompt. See ADR-0003 §3 and docs/policy/idle-policy-defaults.md.",
  "allOf": [
    { "$ref": "common/base-event.schema.json" },
    {
      "type": "object",
      "properties": {
        "event_type": { "const": "USER_PROMPT_RESPONSE" },
        "payload": {
          "type": "object",
          "properties": {
            "response": {
              "type": "string",
              "enum": [
                "still_working",
                "bio_break",
                "meal_break",
                "on_phone_call",
                "working_away",
                "end_shift"
              ]
            },
            "note": {
              "type": ["string", "null"],
              "maxLength": 500,
              "description": "Optional user-provided note. Never stores content of the user's work; free text only, employee-controlled."
            },
            "prompt_shown_at": {
              "type": "string",
              "format": "date-time",
              "description": "When the prompt was rendered on the user's screen. Client-side timestamp."
            }
          },
          "required": ["response", "prompt_shown_at"],
          "additionalProperties": false
        }
      }
    }
  ]
}

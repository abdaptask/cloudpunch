{
  "name": "@cloudpunch/event-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JSON Schemas and canonicalization helpers for the CloudPunch time_event ledger. Source of truth per ADR-0004.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./canonicalize": "./src/canonicalize.ts",
    "./signature": "./src/signature.ts",
    "./event-types.json": "./event-types.json"
  },
  "files": [
    "event-types.json",
    "schemas/",
    "src/",
    "canonicalization.md",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vitest": "^2.1.4"
  }
}

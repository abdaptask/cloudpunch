{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudpunch.aptask.com/schemas/policy/idle-policy.schema.json",
  "title": "CloudPunch idle-policy",
  "description": "Admin-configurable idle, break, system, autostart, notifications, and integrity settings. Defaults documented in docs/policy/idle-policy-defaults.md. Nested objects are individually optional to permit partial overrides at team or per-employee scope.",
  "type": "object",
  "properties": {
    "idle": {
      "type": "object",
      "properties": {
        "threshold_seconds": { "type": "integer", "minimum": 60, "maximum": 3600, "default": 120 },
        "grace_seconds": { "type": "integer", "minimum": 10, "maximum": 300, "default": 30 },
        "max_idle_minutes": {
          "type": ["integer", "null"],
          "minimum": 15,
          "maximum": 480,
          "default": 120,
          "description": "Continuous logged idle closes the session after this long (closed_reason idle_cap). null disables. ADR-0018 §1."
        },
        "suppress_prompt_when_media_active": { "type": "boolean", "default": true },
        "media_state_debounce_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 5
        },
        "max_silent_call_minutes": {
          "type": ["integer", "null"],
          "minimum": 15,
          "maximum": 480,
          "default": 30,
          "description": "While on a call, show the idle prompt after this many minutes with no keyboard or pointer input. null disables the cap. ADR-0010."
        },
        "count_as_payable_when_unresponsive": { "type": "boolean", "default": false },
        "prompt_options": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "still_working",
              "bio_break",
              "meal_break",
              "on_phone_call",
              "working_away",
              "end_shift"
            ]
          },
          "uniqueItems": true,
          "minItems": 2,
          "default": [
            "still_working",
            "bio_break",
            "meal_break",
            "on_phone_call",
            "working_away",
            "end_shift"
          ]
        },
        "call_type_apps": {
          "type": "array",
          "description": "Processes whose microphone use counts as a call, and the category recorded (ADR-0012, ADR-0015 §8). Configuration only: the process name is never recorded, only the category.",
          "items": {
            "type": "object",
            "properties": {
              "process": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9 ._-]+$"
              },
              "call_type": { "type": "string", "enum": ["teams", "zoom", "other"] }
            },
            "required": ["process", "call_type"],
            "additionalProperties": false
          },
          "maxItems": 50,
          "default": [
            { "process": "ms-teams.exe", "call_type": "teams" },
            { "process": "teams.exe", "call_type": "teams" },
            { "process": "zoom.exe", "call_type": "zoom" },
            { "process": "com.microsoft.teams2", "call_type": "teams" },
            { "process": "com.microsoft.teams", "call_type": "teams" },
            { "process": "us.zoom.xos", "call_type": "zoom" }
          ]
        },
        "input_pattern_check": {
          "type": "object",
          "description": "Presence check for propped keys and mouse jigglers, from input timing only (ADR-0024). Off until HR turns it on.",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "continuous_minutes": {
              "type": "integer",
              "minimum": 10,
              "maximum": 120,
              "default": 20
            },
            "periodic_minutes": { "type": "integer", "minimum": 5, "maximum": 60, "default": 10 },
            "min_gap_seconds": { "type": "integer", "minimum": 2, "maximum": 10, "default": 3 }
          },
          "additionalProperties": false
        },
        "call_type_ignored": {
          "type": "array",
          "description": "Processes never treated as a call even while holding the microphone (ADR-0012).",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9 ._-]+$"
          },
          "uniqueItems": true,
          "maxItems": 50,
          "default": ["ace dialer.exe"]
        }
      },
      "additionalProperties": false
    },
    "break": {
      "type": "object",
      "description": "One entry per break type, fixed ids (ADR-0023 §1). max_minutes raises a reminder and, for paid_up_to_limit, is the paid boundary; it never ends a break. pay: paid, unpaid, or paid_up_to_limit (paid up to max_minutes, the rest unpaid).",
      "properties": {
        "bio": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "label": { "type": "string", "minLength": 1, "maxLength": 30, "default": "Bio break" },
            "pay": {
              "type": "string",
              "enum": ["paid", "unpaid", "paid_up_to_limit"],
              "default": "paid_up_to_limit"
            },
            "max_minutes": { "type": "integer", "minimum": 5, "maximum": 180, "default": 10 },
            "payable_up_to_cap": {
              "type": "boolean",
              "default": true,
              "description": "Deprecated by ADR-0023 (use pay); accepted so stored overrides stay valid, otherwise ignored."
            }
          },
          "additionalProperties": false
        },
        "meal": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "label": { "type": "string", "minLength": 1, "maxLength": 30, "default": "Meal break" },
            "pay": {
              "type": "string",
              "enum": ["paid", "unpaid", "paid_up_to_limit"],
              "default": "unpaid"
            },
            "max_minutes": { "type": "integer", "minimum": 5, "maximum": 180, "default": 60 },
            "payable": {
              "type": "boolean",
              "default": false,
              "description": "Deprecated by ADR-0023 (use pay); accepted so stored overrides stay valid, otherwise ignored."
            },
            "min_minutes_before_prompt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 720,
              "default": 0
            }
          },
          "additionalProperties": false
        },
        "rest": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "label": { "type": "string", "minLength": 1, "maxLength": 30, "default": "Tea break" },
            "pay": {
              "type": "string",
              "enum": ["paid", "unpaid", "paid_up_to_limit"],
              "default": "paid_up_to_limit"
            },
            "max_minutes": { "type": "integer", "minimum": 5, "maximum": 180, "default": 15 }
          },
          "additionalProperties": false
        },
        "personal": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "label": { "type": "string", "minLength": 1, "maxLength": 30, "default": "Personal" },
            "pay": {
              "type": "string",
              "enum": ["paid", "unpaid", "paid_up_to_limit"],
              "default": "unpaid"
            },
            "max_minutes": { "type": "integer", "minimum": 5, "maximum": 180, "default": 30 }
          },
          "additionalProperties": false
        },
        "other": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30,
              "default": "Other break"
            },
            "pay": {
              "type": "string",
              "enum": ["paid", "unpaid", "paid_up_to_limit"],
              "default": "unpaid"
            },
            "max_minutes": {
              "type": ["integer", "null"],
              "minimum": 5,
              "maximum": 180,
              "default": null
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "away": {
      "type": "object",
      "properties": {
        "require_note": {
          "type": "object",
          "properties": {
            "working_away": { "type": "boolean", "default": true },
            "phone_call": { "type": "boolean", "default": false },
            "meeting": { "type": "boolean", "default": false },
            "training": { "type": "boolean", "default": false },
            "other": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        "payable_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["working_away", "phone_call", "meeting", "training", "other"]
          },
          "uniqueItems": true,
          "default": ["working_away", "phone_call", "meeting", "training"]
        },
        "offer_training": {
          "type": "boolean",
          "default": true,
          "description": "Offer Training as an Away reason in the app (ADR-0023 §1)."
        },
        "check_after_minutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 240,
          "default": 60,
          "description": "Ask \"Still away?\" after this long, then every 30 minutes; Team exceptions list Aways at least this long (ADR-0027)."
        }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "max_lock_duration_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480,
          "default": 120
        },
        "max_sleep_duration_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480,
          "default": 120
        }
      },
      "additionalProperties": false
    },
    "multi_device": {
      "type": "object",
      "properties": {
        "on_second_signin": {
          "type": "string",
          "enum": ["prompt_take_over", "auto_take_over", "deny"],
          "default": "prompt_take_over"
        }
      },
      "additionalProperties": false
    },
    "autostart": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "employee_can_override": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "notifications": {
      "type": "object",
      "properties": {
        "quiet_hours_start": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "default": "22:00"
        },
        "quiet_hours_end": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "default": "07:00"
        },
        "rate_limit_per_hour": { "type": "integer", "minimum": 1, "maximum": 100, "default": 6 }
      },
      "additionalProperties": false
    },
    "reminders": {
      "type": "object",
      "description": "Desktop on-the-clock reminders. ADR-0013.",
      "properties": {
        "on_clock_minutes": { "type": "integer", "minimum": 10, "maximum": 240, "default": 30 },
        "long_shift_hours": { "type": "integer", "minimum": 4, "maximum": 16, "default": 9 },
        "long_shift_repeat_hours": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
        "clock_in_nudge_minutes": {
          "type": ["integer", "null"],
          "minimum": 10,
          "maximum": 240,
          "default": 30,
          "description": "Signed in but not clocked in yet today, and using the computer: remind every this many minutes. null disables. ADR-0013 §7."
        },
        "long_day_hours": {
          "type": "integer",
          "minimum": 4,
          "maximum": 16,
          "default": 8,
          "description": "End-of-day summary: a clock-out or sign-out after at least this many hours worked today plays the 'Trip complete' animation; shorter days get a quiet summary. ADR-0013 §8."
        },
        "clock_in_prompt_at": {
          "type": ["string", "null"],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "default": "08:00",
          "description": "Daily clock-in popup, HH:MM in clock_in_prompt_tz, on weekdays in that zone. Offers to start from when the person signed in to the computer. null turns it off. ADR-0018 §4."
        },
        "clock_in_prompt_tz": {
          "type": "string",
          "default": "America/New_York",
          "description": "IANA zone for clock_in_prompt_at; follows its daylight saving (8:00 New York is 17:30 IST in summer, 18:30 IST in winter). ADR-0018 §4."
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "properties": {
        "clock_drift_threshold_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300,
          "default": 60
        },
        "clock_sample_interval_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "default": 30
        }
      },
      "additionalProperties": false
    },
    "alerts": {
      "type": "object",
      "description": "Shift-start emails and regular late starters (ADR-0037). Read from the global settings only; a department or employee value is ignored.",
      "properties": {
        "shift_emails": {
          "type": "boolean",
          "default": false,
          "description": "Email the person and their manager about a missed clock-in, the late clock-in that follows, and \"Not working today\". Off until the holiday list is in (ADR-0037 §3)."
        },
        "missed_clock_in_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120,
          "default": 15,
          "description": "Minutes after the shift starts before a missed clock-in email goes (ADR-0037 §3)."
        },
        "regular_late_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "default": 3,
          "description": "Missed starts that make someone a regular late starter (ADR-0037 §4)."
        },
        "regular_late_days": {
          "type": "integer",
          "minimum": 7,
          "maximum": 90,
          "default": 30,
          "description": "Over how many days regular_late_count is counted (ADR-0037 §4)."
        }
      },
      "additionalProperties": false
    },
    "connections": {
      "type": "object",
      "description": "Where people connect from (ADR-0029). Read from the global settings only; a department or employee value is ignored.",
      "properties": {
        "record": {
          "type": "boolean",
          "default": false,
          "description": "Record each device's IP, approximate city and provider. Off until the privacy notice update has gone out (ADR-0029 §7)."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
